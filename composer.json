{
    "name": "porro/php-core",
    "description": "Shared core for Porro connectors: site keys, signing, lock-file reading, sending reports and local site health checks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev/?utm_source=php-core&utm_medium=packagist&utm_campaign=connectors",
    "keywords": [
        "porro",
        "monitoring",
        "composer",
        "security"
    ],
    "require": {
        "php": "^8.2",
        "composer-runtime-api": "^2.2",
        "composer/semver": "^3.4",
        "maxmind-db/reader": "^1.11",
        "paragonie/sodium_compat": "^1.21|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Core\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "1994/coding-standard": "^1.1",
        "laravel/pint": "^1.18",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Porro\\Core\\Tests\\": "tests/",
            "Porro\\Tools\\": "tools/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:check": "pint --test",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "ci:quality": [
            "@lint:check",
            "@analyse"
        ],
        "ci:test": [
            "@test"
        ],
        "ci": [
            "@ci:quality",
            "@ci:test"
        ],
        "ci:lowest": [
            "@composer update --prefer-lowest --prefer-stable --no-interaction --no-progress",
            "@ci:test",
            "@composer update --no-interaction --no-progress"
        ],
        "post-install-cmd": [
            "qa-install-hooks"
        ],
        "post-update-cmd": [
            "qa-install-hooks"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/Porrodev/php-core/issues",
        "source": "https://github.com/Porrodev/php-core"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/1994limited/coding-standard"
        }
    ]
}
