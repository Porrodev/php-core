parameters:
	ignoreErrors:
		-
			message: '#^Method Porro\\Core\\Activity\\FlaggedIp\:\:__construct\(\) has parameter \$badges with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/Activity/FlaggedIp.php

		-
			message: '#^Offset ''from'' on array\{why\: ''Added in this…'', from\: array\{\}\}\|array\{why\: ''Cloudflare sits in…'', from\: array\{''https\://www…''\}\}\|array\{why\: ''Forge checks the…'', from\: array\{''https\://laravel\.com…''\}\}\|array\{why\: ''Google’s and Bing’s…'', from\: array\{''https\://developers…'', ''https\://www\.bing…''\}\}\|array\{why\: ''Laravel Forge…'', from\: array\{''https\://forge…''\}\}\|array\{why\: ''Not on the public…'', from\: array\{''https\://www\.iana…'', ''https\://www\.iana…''\}\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/Activity/ProtectedRanges.php

		-
			message: '#^Variable \$http_response_header on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Client.php

		-
			message: '#^Strict comparison using \=\=\= between non\-falsy\-string and '''' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: src/Cron.php

		-
			message: '#^Parameter \#1 \$array \(list\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: src/Health/Issue.php

		-
			message: '#^Variable \$http_response_header on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.variable
			count: 1
			path: src/Health/Sources.php
